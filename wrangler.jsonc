{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "personal-web",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-11-04",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	}
}
