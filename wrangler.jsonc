{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "personal-web",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-11-04",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"previews": {
		"images": {
			"binding": "IMAGES"
		},
		"kv_namespaces": [
			{
				"binding": "SESSION",
				"id": "bbbed6763e274f3aa0967457190b5386"
			}
		]
	}
}
